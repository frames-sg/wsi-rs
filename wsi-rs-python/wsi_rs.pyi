from os import PathLike
from typing import Any, Literal, Sequence

__version__: str
Coordinates = tuple[int, int]
Region = tuple[int, int, int, int]
Plane = tuple[int, int, int]

class TileHit:
    @property
    def coords(self) -> Coordinates: ...
    @property
    def offset(self) -> tuple[float, float]: ...

class CompressedTile:
    @property
    def data(self) -> bytes: ...
    @property
    def coords(self) -> Coordinates: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def codec(self) -> str: ...
    @property
    def bits_allocated(self) -> int: ...
    @property
    def significant_bits(self) -> int | None: ...
    @property
    def samples_per_pixel(self) -> int: ...
    @property
    def photometric_interpretation(self) -> str: ...
    @property
    def color_transform(self) -> Literal["auto", "ycbcr", "none"]: ...
    @property
    def tile_region(self) -> Region: ...

class EncodedUnit:
    @property
    def path(self) -> str: ...
    @property
    def segments(self) -> list[tuple[int, int]]: ...
    # "standalone", "jpeg_tables", "bare_payload" or "prefixed".
    @property
    def framing(self) -> str: ...
    @property
    def prefix(self) -> bytes: ...
    @property
    def suffix(self) -> bytes: ...
    # compression, bits_per_sample, significant_bits, samples_per_pixel,
    # photometric_interpretation,
    # planar_configuration, channel_order, predictor, byte_order, chroma_subsampling,
    # jpeg_tables.
    @property
    def codec(self) -> dict[str, Any]: ...
    @property
    def stored_size(self) -> tuple[int, int]: ...
    @property
    def source_region(self) -> Region: ...
    @property
    def tile_region(self) -> Region: ...
    def assemble(self, segments: Sequence[bytes | bytearray]) -> bytes: ...
    def to_dict(self) -> dict[str, Any]: ...

class TileLocation:
    # "stored", "absent" or "not_addressable".
    @property
    def kind(self) -> str: ...
    # "synthetic_level", "resampled", "codestream_window" or "not_stored".
    @property
    def reason(self) -> str | None: ...
    @property
    def base_level(self) -> int | None: ...
    @property
    def factor(self) -> int | None: ...
    @property
    def tile_size(self) -> tuple[int, int] | None: ...
    @property
    def units(self) -> tuple[EncodedUnit, ...]: ...
    def to_dict(self) -> dict[str, Any]: ...

class LevelTileLocations:
    @property
    def tile_width(self) -> int: ...
    @property
    def tile_height(self) -> int: ...
    @property
    def tiles_across(self) -> int: ...
    @property
    def tiles_down(self) -> int: ...
    @property
    def tiles(self) -> tuple[tuple[int, int, TileLocation], ...]: ...
    def to_dict(self) -> dict[str, Any]: ...

class Slide:
    def __init__(self, path: str | PathLike[str]) -> None: ...
    @staticmethod
    def open(path: str | PathLike[str]) -> Slide: ...
    @property
    def properties(self) -> dict[str, str]: ...
    @property
    def metadata(self) -> dict[str, Any]: ...
    def levels(self, *, scene: int = 0, series: int = 0) -> list[dict[str, Any]]: ...
    def tiles_for_region(self, region: Region, *, level: int = 0, scene: int = 0, series: int = 0) -> list[TileHit]: ...
    def read_tiles_compressed(self, coords: Sequence[Coordinates], *, level: int = 0, scene: int = 0, series: int = 0, plane: Plane = (0, 0, 0)) -> list[CompressedTile]: ...
    def tile_location(self, col: int, row: int, *, level: int = 0, scene: int = 0, series: int = 0, plane: Plane = (0, 0, 0)) -> TileLocation: ...
    def level_tile_locations(self, *, level: int = 0, scene: int = 0, series: int = 0, plane: Plane = (0, 0, 0)) -> LevelTileLocations: ...
