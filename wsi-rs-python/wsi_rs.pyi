from os import PathLike
from typing import Any, Literal, Sequence

__version__: str
Coordinates = tuple[int, int]
Region = tuple[int, int, int, int]

class TileHit:
    @property
    def coords(self) -> Coordinates: ...
    @property
    def offset(self) -> tuple[float, float]: ...

class CompressedTile:
    @property
    def data(self) -> bytes: ...
    @property
    def coords(self) -> Coordinates: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def codec(self) -> str: ...
    @property
    def bits_allocated(self) -> int: ...
    @property
    def samples_per_pixel(self) -> int: ...
    @property
    def photometric_interpretation(self) -> str: ...
    @property
    def color_transform(self) -> Literal["auto", "ycbcr", "none"]: ...

class Slide:
    def __init__(self, path: str | PathLike[str]) -> None: ...
    @staticmethod
    def open(path: str | PathLike[str]) -> Slide: ...
    @property
    def properties(self) -> dict[str, str]: ...
    @property
    def metadata(self) -> dict[str, Any]: ...
    def levels(self, *, scene: int = 0, series: int = 0) -> list[dict[str, Any]]: ...
    def tiles_for_region(self, region: Region, *, level: int = 0, scene: int = 0, series: int = 0) -> list[TileHit]: ...
    def read_tiles_compressed(self, coords: Sequence[Coordinates], *, level: int = 0, scene: int = 0, series: int = 0, plane: tuple[int, int, int] = (0, 0, 0)) -> list[CompressedTile]: ...
